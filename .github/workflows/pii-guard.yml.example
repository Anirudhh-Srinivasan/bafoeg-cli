# PII guard: blocks invented personal data (mail addresses, Matrikelnummern)
# and committed secrets. Runs on every push to every branch and on every PR.
#
# Diese Datei endet auf .example, weil der Standard-GitHub-PAT des
# Maintainers keinen `workflow`-Scope hat und GitHub das Pushen einer
# echten .yml-Datei in .github/workflows/ blockiert.
# Aktivierung:
#   1. Datei umbenennen auf `pii-guard.yml` (oder Inhalt in die Web-UI
#      kopieren: Settings → Actions → New workflow).
#   2. `scripts/pii_guard.py` und `.pii-allowlist` sind bereits im Repo.
#   3. Optional: gitleaks hinzufügen (siehe Kommentar unten).
# Details: scripts/pii_guard.py, exceptions: .pii-allowlist / .gitleaksignore
name: pii-guard

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  personal-data:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Keine Mailadressen/Matrikelnummern außer Allowlist
        run: python3 scripts/pii_guard.py

  # gitleaks-Block analog zum cli-mcp-template (siehe dort). Ist hier
  # nur auskommentiert, weil keine gitleaks-Version festgenagelt ist.
  # Zum Aktivieren entkommentieren und gitleaks-Version/SHA pinnen.
