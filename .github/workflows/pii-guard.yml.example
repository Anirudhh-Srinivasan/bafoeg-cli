  #     GITLEAKS_SHA256: 551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
  #   steps:
  #     - uses: actions/checkout@v4
  #       with:
  #         fetch-depth: 0
  #     - name: Install gitleaks
  #       run: |
  #         curl -sSfL -o gitleaks.tgz \
  #           "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"
  #         echo "${GITLEAKS_SHA256}  gitleaks.tgz" | sha256sum -c -
  #         tar -xzf gitleaks.tgz -C "$RUNNER_TEMP" gitleaks
  #         rm gitleaks.tgz
  #     - name: Secrets in der Historie dieses Stands
  #       run: |
  #         "$RUNNER_TEMP/gitleaks" git --redact --verbose --no-banner \
  #           --log-opts="HEAD" --exit-code 1 .